# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents setup, so it ships.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# generated from seed.ts on demand
seed.ndjson

# python bytecode from one-off asset scripts
__pycache__/

# dataset snapshots taken before migrations
backup-*.tar.gz

# camera original: HEIC, which browsers cannot display. Kept locally as the
# source for the generated hero-*.jpg files, never shipped.
*.heic

# camera originals: HEIC despite the .jpeg name, unreadable in most browsers.
# Converted copies live in Sanity; these stay local.
public/IMG_*.jpeg

# camera original: 4K60 at 62Mbps. The encoded hero-720/1080 files ship instead.
public/hero.mp4

# working directory for converting camera files before upload
.roompics/
