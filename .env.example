# Copy to .env.local and fill in. Restart the dev server after changing.

# ---------------------------------------------------------------- Sanity
# sanity.io/manage -> create project -> dataset "production" (public).
# Leave the id blank and the site runs on seed content in src/sanity/lib/seed.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Any random string. Paste the same one into the Sanity webhook's secret field.
# Webhook URL: https://your-domain/api/revalidate  (POST, all document types)
SANITY_REVALIDATE_SECRET=

# -------------------------------------------------------------- Telegram
# 1. Message @BotFather -> /newbot -> copy the token below.
# 2. Make a group, turn on Topics, add the bot as an admin.
# 3. Create five topics: Reservations, Restaurant, Lounge, Laundry, Car Hire.
# 4. Send a message in the group, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to read chat.id and
#    message_thread_id for each topic.
# Never prefix these with NEXT_PUBLIC_ — that would ship the token to the browser.
# A topic left blank still delivers, it just lands in the group's General thread.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_RESERVATIONS=
TELEGRAM_TOPIC_RESTAURANT=
TELEGRAM_TOPIC_LOUNGE=
TELEGRAM_TOPIC_LAUNDRY=
TELEGRAM_TOPIC_TRANSPORT=

# ------------------------------------------------------- Flood protection
# Optional. Both have sensible defaults and are only worth setting if the
# hotel gets busier than six submissions a minute from one address, or if a
# flood ever needs clamping down without a deploy.
# NOTIFY_LIMIT_PER_IP=6      submissions per IP per minute
# NOTIFY_LIMIT_GLOBAL=18     Telegram messages per minute, all sources
# The real defence is the Vercel firewall rule; see DEPLOYMENT.md step 4.

# ------------------------------------------------------------------ Site
# Used for canonical URLs, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://blissurbanhotels.com
